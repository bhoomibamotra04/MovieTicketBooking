{
  "name": "movie-booking",
  "version": "1.0.0",
  "scripts": {
    "install-all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix backend",
    "client": "npm start --prefix frontend"
  },
  "dependencies": {
    "concurrently": "^8.2.0"
  }
}
